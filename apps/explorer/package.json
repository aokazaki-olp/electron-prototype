{
  "name": "@app/explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Salesforce Explorer — フル版 (Electron / Salesforce object explorer / SOQL client)",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env BUILD_TARGET=explorer electron-vite dev",
    "build": "cross-env BUILD_TARGET=explorer npm run gen-builder-yml && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml",
    "gen-builder-yml": "cross-env BUILD_TARGET=explorer node ../../scripts/gen-builder-yml.mjs"
  },
  "dependencies": {
    "@app/ipc-contract": "*",
    "@app/libs": "*",
    "@app/main-core": "*",
    "react-resizable-panels": "^4.11.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/view": "^6"
  }
}
