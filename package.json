{
  "name": "salesforce-explorer",
  "version": "0.1.0",
  "description": "Salesforce object explorer / SOQL client (Electron prototype)",
  "main": "out/main/index.js",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.0.0",
  "overrides": {
    "yauzl": "^3.3.1"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "npm run dev:explorer",
    "dev:explorer": "npm -w @app/explorer run dev",
    "dev:compass": "npm -w @app/compass run dev",
    "build": "npm run build:explorer",
    "build:explorer": "npm -w @app/explorer run build",
    "build:compass": "npm -w @app/compass run build",
    "typecheck": "tsc --noEmit -p tsconfig.node.explorer.json && tsc --noEmit -p tsconfig.node.compass.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run dist:explorer",
    "dist:explorer": "npm -w @app/explorer run dist",
    "dist:compass": "npm -w @app/compass run dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@codemirror/lang-sql": "^6",
    "@playwright/test": "^1.46.0",
    "@tanstack/react-table": "^8",
    "@tanstack/react-virtual": "^3.13.25",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@uiw/react-codemirror": "^4",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10",
    "cross-env": "^7",
    "csv-parse": "^5",
    "electron": "^42.0.0",
    "electron-builder": "^25",
    "electron-vite": "^2",
    "happy-dom": "^20.9.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0",
    "playwright-core": "^1.60.0",
    "postcss": "^8",
    "react": "^18",
    "react-dom": "^18",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^4.1.7",
    "zustand": "^5"
  }
}
